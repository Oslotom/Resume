rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation for CVVersion
    function isValidCVVersion(data) {
      return data.userId == request.auth.uid &&
             data.name is string && data.name.size() <= 100 &&
             data.data is map &&
             data.createdAt == request.time &&
             data.updatedAt == request.time;
    }

    match /cv_versions/{versionId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() && 
                      isValidId(versionId) && 
                      isValidCVVersion(incoming());
      
      allow update: if isSignedIn() && 
                      isOwner(existing().userId) &&
                      isValidCVVersion(incoming()) &&
                      incoming().createdAt == existing().createdAt &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'data', 'updatedAt']);

      allow delete: if isSignedIn() && isOwner(existing().userId);
    }
  }
}
